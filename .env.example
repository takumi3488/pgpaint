DATABASE_URL=postgres://localhost/pgpaint_dev

# Generate at least 64 random bytes for secure cookies and saved-profile password encryption.
SECRET_KEY_BASE=

# Gluon server settings. Defaults: 0.0.0.0:3000, secure cookies, embedded templates.
# GLUON_BIND=0.0.0.0:3000
# GLUON_INSECURE_COOKIE=1 # local HTTP development only; never use in production
# GLUON_DEV_TEMPLATES=1 # read app/ and public/ from disk for development

# Gluon telemetry: unset defaults to enabled; false disables it.
OTEL_ENABLED=false
# GLUON_TELEMETRY_DISABLED=1 # highest-precedence opt-out
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=pgpaint
# RUST_LOG=info

# Optional connection-pool eviction timeout. Positive seconds; default is 1800.
# PGPAINT_CONNECTION_IDLE_TTL_SECS=1800

# Shared authentication is disabled unless this is exactly 1.
PGPAINT_AUTH=0
# Required for OAuth or passkeys; public HTTPS origin, e.g. https://pgpaint.example.com
# AUTH_ORIGIN=
# Set AUTH_RP_ID to enable passkeys; requires AUTH_ORIGIN.
# AUTH_RP_ID=
# Email OTP is enabled only when the SMTP fields and OTP secret are all configured.
# AUTH_SMTP_SERVER=
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USERNAME=
# AUTH_SMTP_PASSWORD=
# AUTH_SMTP_FROM=
# AUTH_OTP_SECRET= # at least 32 bytes
# Optional OAuth providers (each requires both values).
# PGPAINT_GOOGLE_CLIENT_ID=
# PGPAINT_GOOGLE_CLIENT_SECRET=
# PGPAINT_GITHUB_CLIENT_ID=
# PGPAINT_GITHUB_CLIENT_SECRET=
# Optional generic OIDC provider (requires issuer, client ID, and client secret).
# PGPAINT_OIDC_ISSUER=
# PGPAINT_OIDC_CLIENT_ID=
# PGPAINT_OIDC_CLIENT_SECRET=
# PGPAINT_OIDC_NAME=oidc
# Optional only with a complete OIDC group; adds PEM roots without replacing platform roots.
# PGPAINT_OIDC_CA_FILE=/path/to/ca.pem

# Aurora DSQL IAM auth uses the AWS SDK default credential chain. Supply AWS credentials
# through your usual AWS profile, environment, or workload identity configuration.
# Testkit only: override the Docker daemon host for tests in a different network namespace.
# PGPAINT_TESTCONTAINERS_HOST=192.168.64.1